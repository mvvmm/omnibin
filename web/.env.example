# Local Worker bindings. Copy to .env and populate these values.
# Set the same names as Worker secrets in Cloudflare; never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Prisma migration commands use the direct Supabase connection.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
AUTH0_DOMAIN=https://YOUR_TENANT.auth0.com/
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# A cryptographically random 32-byte value encoded as 64 hex characters.
AUTH0_SECRET=
AUTH0_AUDIENCE=
AUTH0_SCOPE=openid profile email offline_access
AUTH0_SESSION_INACTIVITY_DURATION=86400
AUTH0_SESSION_ABSOLUTE_DURATION=259200
AUTH0_MANAGEMENT_DOMAIN=YOUR_TENANT.auth0.com
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
AWS_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
