{
  "name": "omnibin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "cf dev",
    "dev:remote": "cf dev --mode remote",
    "build": "cf build",
    "start": "cf dev",
    "lint": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "check": "astro check",
    "db:migrate": "cf d1 migrations apply d5b1817c-069b-46c7-843c-226f107681f0",
    "db:migrate:local": "cf d1 migrations apply d5b1817c-069b-46c7-843c-226f107681f0 --local --persist-to .cloudflare/state",
    "db:diff": "prisma migrate diff --from-url \"file:$(ls .cloudflare/state/v3/d1/miniflare-D1DatabaseObject/[0-9a-f]*.sqlite)\" --to-schema-datamodel prisma/schema.prisma --script",
    "deploy": "pnpm run db:migrate && cf deploy",
    "deploy:preview": "cf previews deploy",
    "types": "cf workers types",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@auth0/auth0-server-js": "1.16.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@prisma/adapter-d1": "6.19.2",
    "@prisma/client": "6.19.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "auth0": "^5.0.0",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "he": "^1.2.0",
    "jose": "^5.8.0",
    "lucide-react": "^0.539.0",
    "next-themes": "^0.3.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "15.0.0-beta.1",
    "@astrojs/react": "7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/he": "^1.2.3",
    "@types/node": "^22",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "astro": "7.4.0-beta.1",
    "cf": "1.0.0-beta.18",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "prisma": "6.19.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.7",
      "@types/react-dom": "19.2.3"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "esbuild",
      "workerd"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  }
}
